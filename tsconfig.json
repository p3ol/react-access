{
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "types": ["vitest/globals", "node", "react", "react-dom", "webpack-dev-server"],
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "target": "es2015",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "./*.ts"
  ],
  "exclude": [
    "**/dist/*",
    "node_modules/**/*",
  ]
}
