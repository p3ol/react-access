{
  "name": "@poool/react-access",
  "version": "5.0.1",
  "description": "The easiest way to add Poool Access to your React app ✨",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p3ol/react-access.git"
  },
  "author": "Ugo Stephant <ugo@poool.fr>",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "workspaces": [
    "examples/*"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@junipero/core": "3.14.1",
    "@types/poool-access": "5.19.0"
  },
  "devDependencies": {
    "@poool/oxlint-config": "6.3.0",
    "@swc/core": "1.16.21",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "5.28.5",
    "@types/webpack-dev-server": "4.7.2",
    "commit-and-tag-version": "13.3.0",
    "commitlint": "21.2.4",
    "eslint": "10.14.0",
    "html-webpack-plugin": "5.6.8",
    "jest-dev-server": "11.0.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "oxlint": "1.90.0",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "swc-loader": "0.2.7",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "scripts": {
    "clean": "rm -rf ./dist || true",
    "build": "yarn clean && yarn build:code && yarn build:types",
    "build:code": "tsdown",
    "build:types": "tsc --project ./tsconfig.build.json",
    "prepack": "yarn build && yarn lint && yarn tsc && yarn test",
    "test": "vitest run",
    "lint": "oxlint",
    "release": "commit-and-tag-version && git push --follow-tags",
    "release:dry": "commit-and-tag-version --dry-run",
    "example:basic": "yarn workspace poool-react-access-basic-example serve",
    "example:next": "yarn workspace poool-react-access-next-example dev"
  },
  "resolutions": {
    "ws": "8.12.0"
  },
  "targets": [
    "chrome109",
    "edge138",
    "firefox140",
    "safari18",
    "opera80",
    "node20"
  ],
  "packageManager": "yarn@4.18.1"
}
